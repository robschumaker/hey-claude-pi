[Unit]
Description=Household voice assistant (Hey Claude) on the ReSpeaker
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/household-mcp
Environment=ENV_FILE=/home/pi/household/.env
ExecStartPre=/home/pi/household-mcp/voice/mic-check.sh
ExecStart=/home/pi/household-mcp/venv-voice/bin/python /home/pi/household-mcp/voice/daemon.py
# Beat the kiosk's Chromium to the CPU while a request is in flight (default Nice 0, CPUWeight 100).
# The 2026-10-24 cap (CPUQuota=200%, Nice=5) starved the audio reader during Claude Code warm-ups:
# constant input overflows, chopped recordings. Never cap this service.
Nice=-10
CPUWeight=1000
IOWeight=500
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
